# Exaroton API Credentials
# Generate your API token at: https://exaroton.com/account/
EXAROTON_API_TOKEN=your_exaroton_api_token_here

# Your server ID can be found in the server URL or settings on exaroton.com
EXAROTON_SERVER_ID=your_server_id_here

# Remote path inside server (defaults to mods/)
EXAROTON_MODS_DIR=mods

# Restart server after deploy (true/false)
EXAROTON_AUTO_RESTART=false
